{
  "name": "CustomOrder",
  "type": "object",
  "properties": {
    "request_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "description": "Requested simulation quantity"
    },
    "unit": {
      "type": "string",
      "enum": [
        "K",
        "M",
        "B"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple"
      ]
    },
    "requested_units": {
      "type": "number",
      "description": "Quantity converted to units"
    },
    "blockchain": {
      "type": "string"
    },
    "requirements": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "reviewing",
        "quoted",
        "closed"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "purple",
        "gray"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "email",
    "quantity",
    "unit",
    "blockchain"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}