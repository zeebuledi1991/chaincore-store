{
  "name": "SiteContent",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Stable content key, e.g. home.hero.badge"
    },
    "value": {
      "type": "string",
      "description": "Published value shown on the live website"
    },
    "draft_value": {
      "type": "string",
      "description": "Unpublished draft value waiting to be published",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    },
    "hidden": {
      "type": "boolean",
      "default": false,
      "description": "Hide this element on the live website"
    },
    "updated_by": {
      "type": "string",
      "description": "Email of the administrator who last edited this element",
      "rls": {
        "read": {
          "$or": [
            {
              "created_by_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      }
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}